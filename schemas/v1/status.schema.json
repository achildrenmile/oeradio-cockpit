{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Aggregator health. The last will only carries ``v``, ``ts`` and ``offline``.",
  "properties": {
    "v": {
      "const": 1,
      "default": 1,
      "title": "V",
      "type": "integer"
    },
    "ts": {
      "title": "Ts",
      "type": "integer"
    },
    "src_ts": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Src Ts"
    },
    "agg": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agg"
    },
    "ok": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "boolean"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ok"
    },
    "motd": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Motd"
    },
    "offline": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Offline"
    }
  },
  "required": [
    "v",
    "ts"
  ],
  "title": "Status",
  "type": "object"
}
