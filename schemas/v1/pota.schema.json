{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "PotaSpot": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "t": {
          "title": "T",
          "type": "integer"
        },
        "act": {
          "title": "Act",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "park": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Park"
        },
        "loc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loc"
        },
        "f": {
          "title": "F",
          "type": "integer"
        },
        "b": {
          "title": "B",
          "type": "string"
        },
        "m": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "M"
        },
        "sp": {
          "title": "Sp",
          "type": "string"
        },
        "cmt": {
          "anyOf": [
            {
              "maxLength": 30,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cmt"
        }
      },
      "required": [
        "id",
        "t",
        "act",
        "ref",
        "f",
        "b",
        "sp"
      ],
      "title": "PotaSpot",
      "type": "object"
    }
  },
  "properties": {
    "v": {
      "const": 1,
      "default": 1,
      "title": "V",
      "type": "integer"
    },
    "ts": {
      "title": "Ts",
      "type": "integer"
    },
    "src_ts": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Src Ts"
    },
    "max": {
      "default": 20,
      "maximum": 20,
      "title": "Max",
      "type": "integer"
    },
    "spots": {
      "items": {
        "$ref": "#/$defs/PotaSpot"
      },
      "maxItems": 20,
      "title": "Spots",
      "type": "array"
    }
  },
  "required": [
    "v",
    "ts",
    "spots"
  ],
  "title": "Pota",
  "type": "object"
}
